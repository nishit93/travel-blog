---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AboutTeaserImage from '../assets/blog-placeholder-about.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { BASE_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { slugify } from '../utils';

const base = BASE_URL;

const allPosts = await getCollection('blog');

const latestPosts = [...allPosts]
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const countryOrder: string[] = [];
const countryImages = new Map<string, (typeof allPosts)[number]['data']['heroImage']>();
for (const post of allPosts) {
	const country = post.data.country;
	if (!country) continue;
	if (!countryImages.has(country)) {
		countryOrder.push(country);
		countryImages.set(country, post.data.heroImage);
	}
}
const countries = countryOrder.map((country) => ({
	country,
	heroImage: countryImages.get(country),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.wrap {
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1.5em;
			}

			.hero {
				position: relative;
				overflow: hidden;
				background: rgb(var(--black));
			}
			.hero-content {
				position: relative;
				z-index: 1;
				max-width: 720px;
				margin: 0 auto;
				padding: 3rem 1.5em;
				display: flex;
				flex-direction: column;
				color: #fff;
			}
			.hero-content .eyebrow {
				color: rgba(255, 255, 255, 0.8);
			}
			.hero-content h1 {
				font-size: clamp(2.4rem, 6vw, 3.6rem);
				color: #fff;
				margin: 0 0 0.6rem;
			}
			.hero-dek {
				font-size: 1.15rem;
				color: rgba(255, 255, 255, 0.9);
				max-width: 56ch;
				margin: 0 0 1.7rem;
				line-height: 1.6;
			}
			.hero-cta {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				width: fit-content;
				background: var(--accent);
				color: #fff;
				padding: 0.75em 1.4em;
				border-radius: 999px;
				text-decoration: none;
				font-weight: 600;
				transition:
					background 0.2s ease,
					transform 0.2s ease;
			}
			.hero-cta:hover {
				background: var(--accent-dark);
				transform: translateY(-1px);
			}

			.countries {
				padding: 4rem 1.5em 1rem;
			}
			.countries h2 {
				font-size: 1.9rem;
				margin: 0 0 1.5rem;
			}
			.countries-grid {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1rem;
			}
			@media (max-width: 860px) {
				.countries-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}
			@media (max-width: 560px) {
				.countries-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			.country-card {
				position: relative;
				aspect-ratio: 4 / 5;
				border-radius: 14px;
				overflow: hidden;
				text-decoration: none;
				transition: transform 0.2s ease;
			}
			.country-card:hover {
				transform: translateY(-3px);
			}
			.country-card::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgba(20, 14, 10, 0) 40%, rgba(20, 14, 10, 0.7) 100%);
			}
			.country-card :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
			}
			.country-name {
				position: absolute;
				left: 1rem;
				bottom: 0.9rem;
				z-index: 1;
				color: #fff;
				font-family: var(--font-display);
				font-size: 1.3rem;
			}

			.latest {
				padding: 3rem 1.5em 2rem;
			}
			.section-head {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 2rem;
				flex-wrap: wrap;
			}
			.section-head h2 {
				font-size: 1.9rem;
				margin: 0;
			}
			.view-all {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				text-decoration: none;
				white-space: nowrap;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.6rem;
			}
			@media (max-width: 860px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}

			.about-teaser {
				display: flex;
				align-items: center;
				gap: 2.5rem;
				padding: 4rem 1.5em 5rem;
			}
			.about-photo-wrap {
				flex-shrink: 0;
				width: 200px;
				height: 200px;
				border-radius: 50%;
				overflow: hidden;
			}
			.about-photo-wrap :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.about-teaser h2 {
				font-size: 1.7rem;
				margin: 0 0 0.6rem;
			}
			.about-teaser p {
				color: rgb(var(--gray-dark));
				max-width: 52ch;
				margin: 0 0 1rem;
			}
			.about-teaser a {
				font-family: var(--font-mono);
				font-size: 0.85rem;
			}
			@media (max-width: 620px) {
				.about-teaser {
					flex-direction: column;
					text-align: center;
					gap: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-content">
					<p class="eyebrow">Travel journal</p>
					<h1>{SITE_TITLE}</h1>
					<p class="hero-dek">{SITE_DESCRIPTION}</p>
					<a class="hero-cta" href={`${base}blog/`}>Read the latest stories →</a>
				</div>
			</section>

			{
				countries.length > 0 && (
					<section class="countries wrap">
						<p class="eyebrow">Browse by destination</p>
						<h2>Countries</h2>
						<div class="countries-grid">
							{countries.map(({ country, heroImage }) => (
								<a class="country-card" href={`${base}country/${slugify(country)}/`}>
									{heroImage && <Image src={heroImage} alt="" width={400} height={500} />}
									<span class="country-name">{country}</span>
								</a>
							))}
						</div>
					</section>
				)
			}

			<section class="latest wrap">
				<div class="section-head">
					<div>
						<p class="eyebrow">Recently published</p>
						<h2>Latest stories</h2>
					</div>
					<a class="view-all" href={`${base}blog/`}>View all posts →</a>
				</div>
				<div class="post-grid">
					{
						latestPosts.map((post) => (
							<PostCard
								href={`${base}blog/${post.id}/`}
								title={post.data.title}
								description={post.data.description}
								pubDate={post.data.pubDate}
								heroImage={post.data.heroImage}
								location={post.data.location}
							/>
						))
					}
				</div>
			</section>

			<section class="about-teaser wrap">
				<div class="about-photo-wrap">
					<Image src={AboutTeaserImage} alt="" width={400} height={400} />
				</div>
				<div>
					<p class="eyebrow">Who's writing</p>
					<h2>Hi, I'm Nishit Jain</h2>
					<p>
						This is where I write up the trips as they happen — the places worth the detour, the
						food worth the wait, and the things I'd do differently next time.
					</p>
					<a href={`${base}about/`}>More about me →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
