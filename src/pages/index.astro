---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import AboutTeaserImage from '../assets/blog-placeholder-about.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { BASE_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { slugify } from '../utils';

const base = BASE_URL;

const allPosts = await getCollection('blog');

const sortedPosts = [...allPosts].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// The newest post leads the page; the rails below it split travel from food.
const featuredPost = sortedPosts[0];
const travelPosts = sortedPosts
	.filter((post) => post.id !== featuredPost?.id && post.data.category !== 'food')
	.slice(0, 3);
const foodPosts = sortedPosts
	.filter((post) => post.id !== featuredPost?.id && post.data.category === 'food')
	.slice(0, 3);

const countryOrder: string[] = [];
const countryImages = new Map<string, (typeof allPosts)[number]['data']['heroImage']>();
for (const post of allPosts) {
	const country = post.data.country;
	if (!country) continue;
	if (!countryImages.has(country)) {
		countryOrder.push(country);
		countryImages.set(country, post.data.heroImage);
	}
}
const countries = countryOrder.map((country) => ({
	country,
	heroImage: countryImages.get(country),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.wrap {
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1.5em;
			}

			.site-tagline {
				margin: 0;
				padding: 1.3rem 1.5em;
				text-align: center;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.07em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}

			.featured-link {
				position: relative;
				display: block;
				height: min(52vh, 460px);
				min-height: 320px;
				overflow: hidden;
				text-decoration: none;
				background: rgb(var(--black));
			}
			.featured-link :global(.featured-image) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.featured-overlay {
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgba(20, 14, 10, 0.15) 30%, rgba(20, 14, 10, 0.82) 100%);
			}
			.featured-content {
				position: relative;
				z-index: 1;
				height: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1.5em 2.5rem;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				color: #fff;
			}
			.featured-content .eyebrow {
				color: rgba(255, 255, 255, 0.8);
				margin-bottom: 0.4rem;
			}
			.featured-content h1 {
				color: #fff;
				font-size: clamp(1.9rem, 4.5vw, 3rem);
				margin: 0 0 0.5rem;
				max-width: 22ch;
			}
			.featured-meta {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: rgba(255, 255, 255, 0.85);
				margin: 0 0 1rem;
			}
			.featured-cta {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: #fff;
				border-bottom: 1px solid rgba(255, 255, 255, 0.5);
				padding-bottom: 2px;
				align-self: flex-start;
				transition: border-color 0.2s ease;
			}
			.featured-link:hover .featured-cta {
				border-bottom-color: #fff;
			}

			.countries {
				padding: 4rem 1.5em 1rem;
			}
			.countries h2 {
				font-size: 1.9rem;
				margin: 0 0 1.5rem;
			}
			.countries-grid {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1rem;
			}
			@media (max-width: 860px) {
				.countries-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}
			@media (max-width: 560px) {
				.countries-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			.country-card {
				position: relative;
				aspect-ratio: 4 / 5;
				border-radius: 14px;
				overflow: hidden;
				text-decoration: none;
				transition: transform 0.2s ease;
			}
			.country-card:hover {
				transform: translateY(-3px);
			}
			.country-card::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgba(20, 14, 10, 0) 40%, rgba(20, 14, 10, 0.7) 100%);
			}
			.country-card :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
			}
			.country-name {
				position: absolute;
				left: 1rem;
				bottom: 0.9rem;
				z-index: 1;
				color: #fff;
				font-family: var(--font-display);
				font-size: 1.3rem;
			}

			.latest {
				padding: 3rem 1.5em 2rem;
			}
			.section-head {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 2rem;
				flex-wrap: wrap;
			}
			.section-head h2 {
				font-size: 1.9rem;
				margin: 0;
			}
			.view-all {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				text-decoration: none;
				white-space: nowrap;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.6rem;
			}
			@media (max-width: 860px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}

			.about-teaser {
				display: flex;
				align-items: center;
				gap: 2.5rem;
				padding: 4rem 1.5em 5rem;
			}
			.about-photo-wrap {
				flex-shrink: 0;
				width: 200px;
				height: 200px;
				border-radius: 50%;
				overflow: hidden;
			}
			.about-photo-wrap :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.about-teaser h2 {
				font-size: 1.7rem;
				margin: 0 0 0.6rem;
			}
			.about-teaser p {
				color: rgb(var(--gray-dark));
				max-width: 52ch;
				margin: 0 0 1rem;
			}
			.about-teaser a {
				font-family: var(--font-mono);
				font-size: 0.85rem;
			}
			@media (max-width: 620px) {
				.about-teaser {
					flex-direction: column;
					text-align: center;
					gap: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="site-tagline">{SITE_DESCRIPTION}</p>

			{
				featuredPost && (
					<section class="featured">
						<a class="featured-link" href={`${base}blog/${featuredPost.id}/`}>
							{featuredPost.data.heroImage && (
								<Image
									class="featured-image"
									src={featuredPost.data.heroImage}
									alt=""
									width={1600}
									height={900}
								/>
							)}
							<div class="featured-overlay" />
							<div class="featured-content">
								<p class="eyebrow">Latest story</p>
								<h1>{featuredPost.data.title}</h1>
								<p class="featured-meta">
									<FormattedDate date={featuredPost.data.pubDate} />
									{featuredPost.data.location && <span>· {featuredPost.data.location}</span>}
								</p>
								<span class="featured-cta">Read the story →</span>
							</div>
						</a>
					</section>
				)
			}

			{
				travelPosts.length > 0 && (
					<section class="latest wrap">
						<div class="section-head">
							<div>
								<p class="eyebrow">Recently published</p>
								<h2>Latest stories</h2>
							</div>
							<a class="view-all" href={`${base}blog/`}>
								View all posts →
							</a>
						</div>
						<div class="post-grid">
							{travelPosts.map((post) => (
								<PostCard
									href={`${base}blog/${post.id}/`}
									title={post.data.title}
									description={post.data.description}
									pubDate={post.data.pubDate}
									heroImage={post.data.heroImage}
									location={post.data.location}
								/>
							))}
						</div>
					</section>
				)
			}

			{
				foodPosts.length > 0 && (
					<section class="latest wrap">
						<div class="section-head">
							<div>
								<p class="eyebrow">Worth the detour</p>
								<h2>From the kitchen</h2>
							</div>
							<a class="view-all" href={`${base}food/`}>
								All food posts →
							</a>
						</div>
						<div class="post-grid">
							{foodPosts.map((post) => (
								<PostCard
									href={`${base}blog/${post.id}/`}
									title={post.data.title}
									description={post.data.description}
									pubDate={post.data.pubDate}
									heroImage={post.data.heroImage}
									location={post.data.location}
								/>
							))}
						</div>
					</section>
				)
			}

			{
				countries.length > 0 && (
					<section class="countries wrap">
						<p class="eyebrow">Browse by destination</p>
						<h2>Countries</h2>
						<div class="countries-grid">
							{countries.map(({ country, heroImage }) => (
								<a class="country-card" href={`${base}country/${slugify(country)}/`}>
									{heroImage && <Image src={heroImage} alt="" width={400} height={500} />}
									<span class="country-name">{country}</span>
								</a>
							))}
						</div>
					</section>
				)
			}

			<section class="about-teaser wrap">
				<div class="about-photo-wrap">
					<Image src={AboutTeaserImage} alt="" width={400} height={400} />
				</div>
				<div>
					<p class="eyebrow">Who's writing</p>
					<h2>Hi, I'm Nishit Jain</h2>
					<p>
						This is where I write up the trips as they happen — the places worth the detour, the
						food worth the wait, and the things I'd do differently next time.
					</p>
					<a href={`${base}about/`}>More about me →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
