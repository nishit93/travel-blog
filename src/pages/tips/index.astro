---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { BASE_URL, SITE_TITLE } from '../../consts';

const base = BASE_URL;

const posts = (await getCollection('blog', ({ data }) => data.category === 'tips')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Tips · ${SITE_TITLE}`}
			description="Practical, general travel tips that apply wherever you're headed."
		/>
		<style>
			main {
				width: 100%;
				max-width: 1080px;
			}
			.page-head {
				padding: 3.5rem 0 2.5rem;
				border-bottom: 1px solid rgba(var(--black), 8%);
				margin-bottom: 2.5rem;
			}
			.page-head h1 {
				font-size: clamp(2rem, 4vw, 2.6rem);
				margin: 0 0 0.5rem;
			}
			.page-head p {
				color: rgb(var(--gray-dark));
				max-width: 60ch;
				margin: 0;
			}
			.content-layout {
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 2.5rem;
				padding-bottom: 4rem;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.6rem;
				align-content: start;
			}
			.post-grid > :global(.post-card:first-child) {
				grid-column: 1 / -1;
			}
			.empty {
				color: rgb(var(--gray));
			}
			@media (max-width: 860px) {
				.content-layout {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 720px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<p class="eyebrow">Before you go</p>
				<h1>Tips</h1>
				<p>Practical, general travel tips that apply wherever you're headed.</p>
			</div>
			<div class="content-layout">
				<div class="post-grid">
					{
						posts.length > 0 ? (
							posts.map((post, i) => (
								<PostCard
									href={`${base}blog/${post.id}/`}
									title={post.data.title}
									description={post.data.description}
									pubDate={post.data.pubDate}
									heroImage={post.data.heroImage}
									location={post.data.location}
									large={i === 0}
									imageAspect={i === 0 ? '21 / 9' : '4 / 3'}
								/>
							))
						) : (
							<p class="empty">No tips published yet — check back soon.</p>
						)
					}
				</div>
				<Sidebar />
			</div>
		</main>
		<Footer />
	</body>
</html>
