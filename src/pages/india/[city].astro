---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { BASE_URL, SITE_TITLE } from '../../consts';
import { slugify } from '../../utils';

export async function getStaticPaths() {
	const posts = await getCollection(
		'blog',
		({ data }) => data.country === 'India' && Boolean(data.city),
	);
	const cities = [...new Set(posts.map((post) => post.data.city as string))];

	return cities.map((city) => {
		const cityPosts = posts
			.filter((post) => post.data.city === city)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return {
			params: { city: slugify(city) },
			props: { city, posts: cityPosts },
		};
	});
}

const { city, posts } = Astro.props;
const base = BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${city}, India · ${SITE_TITLE}`} description={`Stories from ${city}, India.`} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
			}
			.page-head {
				padding: 3.5rem 0 2.5rem;
				border-bottom: 1px solid rgba(var(--black), 8%);
				margin-bottom: 2.5rem;
			}
			.back-link {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				text-decoration: none;
				margin-bottom: 1rem;
			}
			.page-head h1 {
				font-size: clamp(2rem, 4vw, 2.6rem);
				margin: 0;
			}
			.content-layout {
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 2.5rem;
				padding-bottom: 4rem;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.6rem;
				align-content: start;
			}
			.post-grid > :global(.post-card:first-child) {
				grid-column: 1 / -1;
			}
			@media (max-width: 860px) {
				.content-layout {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 720px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<a class="back-link" href={`${base}country/${slugify('India')}/`}>← All of India</a>
				<p class="eyebrow">India</p>
				<h1>{city}</h1>
			</div>
			<div class="content-layout">
				<div class="post-grid">
					{
						posts.map((post, i) => (
							<PostCard
								href={`${base}blog/${post.id}/`}
								title={post.data.title}
								description={post.data.description}
								pubDate={post.data.pubDate}
								heroImage={post.data.heroImage}
								location={post.data.location}
								large={i === 0}
								imageAspect={i === 0 ? '21 / 9' : '4 / 3'}
							/>
						))
					}
				</div>
				<Sidebar />
			</div>
		</main>
		<Footer />
	</body>
</html>
