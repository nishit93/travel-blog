---
import { getCollection } from 'astro:content';
import { BASE_URL, SITE_TITLE } from '../consts';
import { groupByRegion, slugify } from '../utils';
import HeaderLink from './HeaderLink.astro';

const base = BASE_URL;

const posts = await getCollection('blog', ({ data }) => Boolean(data.country));
const countries = [...new Set(posts.map((post) => post.data.country as string))];
const grouped = groupByRegion(countries);

const indiaCities = [
	...new Set(
		posts
			.filter((post) => post.data.country === 'India' && Boolean(post.data.city))
			.map((post) => post.data.city as string),
	),
].sort();
---

<header>
	<nav>
		<h2><a href={base}>{SITE_TITLE}</a></h2>
		<button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
			<span class="sr-only">Menu</span>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
		</button>
		<div class="internal-links" id="nav-menu">
			<HeaderLink href={base}>Home</HeaderLink>
			<HeaderLink href={`${base}blog/`}>Blog</HeaderLink>
			{
				grouped.length > 0 && (
					<details class="countries-dropdown">
						<summary>Destinations</summary>
						<div class="dropdown-panel">
							{grouped.map(({ region, countries: regionCountries }) => (
								<div class="region-group">
									<p class="region-label">{region}</p>
									<ul>
										{region === 'India'
											? indiaCities.map((city) => (
													<li>
														<a href={`${base}india/${slugify(city)}/`}>{city}</a>
													</li>
												))
											: regionCountries.sort().map((country) => (
													<li>
														<a href={`${base}country/${slugify(country)}/`}>{country}</a>
													</li>
												))}
									</ul>
								</div>
							))}
							<a class="all-destinations" href={`${base}destinations/`}>
								View all destinations →
							</a>
						</div>
					</details>
				)
			}
			<HeaderLink href={`${base}guides/`}>Guides</HeaderLink>
			<HeaderLink href={`${base}food/`}>Food</HeaderLink>
			<HeaderLink href={`${base}tips/`}>Tips</HeaderLink>
			<HeaderLink href={`${base}about/`}>About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: relative;
	}
	h2 {
		margin: 0;
		font-size: 1.15em;
		font-family: var(--font-display);
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		border: none;
		background: transparent;
		cursor: pointer;
		padding: 0;
	}
	.nav-toggle-bar {
		display: block;
		width: 22px;
		height: 2px;
		background: rgb(var(--black));
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.countries-dropdown {
		position: relative;
		display: inline-block;
	}
	.countries-dropdown summary {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		cursor: pointer;
		list-style: none;
		border-bottom: 4px solid transparent;
	}
	.countries-dropdown summary::-webkit-details-marker {
		display: none;
	}
	.countries-dropdown summary::after {
		content: '▾';
		margin-left: 0.3em;
		font-size: 0.75em;
	}
	.countries-dropdown[open] summary::after {
		content: '▴';
	}
	.dropdown-panel {
		position: absolute;
		top: 100%;
		right: 0;
		margin: 0;
		padding: 1em;
		background: var(--surface);
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		min-width: 480px;
		z-index: 10;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5em 1.5em;
	}
	.region-group ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.region-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
		margin: 0 0 0.4em;
	}
	.dropdown-panel li a {
		display: block;
		padding: 0.35em 0;
		border-bottom: none;
		white-space: nowrap;
		font-size: 0.9rem;
	}
	.dropdown-panel li a:hover {
		color: var(--accent);
	}
	.all-destinations {
		grid-column: 1 / -1;
		margin-top: 0.3em;
		padding-top: 0.8em;
		border-top: 1px solid rgba(var(--black), 8%);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			padding: 0.7em 0;
		}
		.nav-toggle {
			display: flex;
		}
		.nav-open .nav-toggle-bar:nth-child(2) {
			transform: translateY(7px) rotate(45deg);
		}
		.nav-open .nav-toggle-bar:nth-child(3) {
			opacity: 0;
		}
		.nav-open .nav-toggle-bar:nth-child(4) {
			transform: translateY(-7px) rotate(-45deg);
		}
		.internal-links {
			display: none;
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			padding-bottom: 0.8em;
		}
		.nav-open .internal-links {
			display: flex;
		}
		.internal-links a {
			padding: 0.8em 0.2em;
			border-bottom: 1px solid rgba(var(--black), 8%);
		}
		.internal-links a.active {
			border-bottom: 1px solid rgba(var(--black), 8%);
		}
		.countries-dropdown {
			display: block;
		}
		.countries-dropdown summary {
			padding: 0.8em 0.2em;
			border-bottom: 1px solid rgba(var(--black), 8%);
		}
		.dropdown-panel {
			position: static;
			box-shadow: none;
			border-radius: 0;
			padding: 0.5em 0 0.5em 1em;
			min-width: 0;
			display: block;
		}
		.region-group {
			margin-bottom: 0.8em;
		}
		.dropdown-panel li a {
			border-bottom: 1px solid rgba(var(--black), 8%);
			padding: 0.6em 0;
		}
		.all-destinations {
			border-top: none;
			padding-top: 0.4em;
			display: block;
		}
	}
</style>

<script>
	const nav = document.querySelector('nav');
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');

	toggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('nav-open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});

	document.querySelectorAll<HTMLDetailsElement>('.countries-dropdown').forEach((menu) => {
		document.addEventListener('click', (e) => {
			if (!menu.contains(e.target as Node)) menu.open = false;
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') menu.open = false;
		});
		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				menu.open = false;
			});
		});
	});
</script>
