---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { BASE_URL, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, location } = Astro.props;
const base = BASE_URL;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.hero-image {
				width: 100%;
				height: min(56vh, 480px);
				overflow: hidden;
			}
			.hero-image :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.back-link {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				text-decoration: none;
				margin: 2rem 0 1rem;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.6em 0;
			}
			.meta {
				margin-bottom: 0.5em;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: rgb(var(--gray));
			}
			.meta .location {
				color: var(--accent);
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1600} height={900} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<a class="back-link" href={`${base}blog/`}>← All stories</a>
					<div class="title">
						<p class="meta">
							<FormattedDate date={pubDate} />
							{location && <span class="location">· {location}</span>}
						</p>
						{
							updatedDate && (
								<p class="last-updated-on">Last updated on <FormattedDate date={updatedDate} /></p>
							)
						}
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
